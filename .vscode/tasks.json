{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter: get",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "group": "build"
    },
    {
      "label": "flutter: run",
      "type": "shell",
      "command": "flutter",
      "args": ["run"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "flutter: build apk",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "apk", "--release"],
      "group": "build"
    },
    {
      "label": "flutter: build ios",
      "type": "shell",
      "command": "flutter",
      "args": ["build", "ios", "--release"],
      "group": "build"
    }
  ]
}
